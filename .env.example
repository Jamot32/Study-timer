# Deployed Google Apps Script /exec URL
EXPO_PUBLIC_AUTH_ENDPOINT=https://script.google.com/macros/s/DEPLOYMENT_ID/exec

# OAuth 2.0 client IDs from the same Google Cloud project
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com

# Build-time reversed iOS client ID used by the Expo config plugin
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.YOUR_IOS_CLIENT_ID_PREFIX
